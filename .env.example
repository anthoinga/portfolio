# Public (safe in the client). Copy to apps/web/.env
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
# Local: http://localhost:5173 — Vercel production must be https://inga.dev
PUBLIC_SITE_URL=http://localhost:5173

# Server-only. Never prefix with PUBLIC_.
SANITY_API_READ_TOKEN=

# Where content comes from: "fixtures" (typed content in the repo, default) or "sanity".
# Production builds with "sanity" fail loudly if Sanity is unreachable or empty.
PUBLIC_CONTENT_SOURCE=fixtures

# Optional. "vercel" turns on Vercel Web Analytics (cookieless). Enable Analytics in the Vercel dashboard first.
PUBLIC_ANALYTICS=
